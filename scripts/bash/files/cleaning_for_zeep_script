
    """GENERIC CODE FOR CLEANING."""
    import re

    _REF = re.compile(rb'&#(?:[xX]([0-9A-Fa-f]+)|(\d+));')

    def _valid_ref(m: "re.Match[bytes]") -> bytes:
        hex_part, dec_part = m.group(1), m.group(2)
        cp = int(hex_part, 16) if hex_part else int(dec_part, 10)
        if cp in (0x09, 0x0A, 0x0D):
            return m.group(0)
        if cp < 0x20 or 0xD800 <= cp <= 0xDFFF or cp in (0xFFFE, 0xFFFF):
            return b''
        return m.group(0)

    _RAW = re.compile(rb'[\x00-\x08\x0b\x0c\x0e-\x1f]')

    if isinstance(content, str):
        content = _REF.sub(_valid_ref, content.encode('utf-8'))
        content = _RAW.sub(b'', content)
        content = content.decode('utf-8')
    else:
        content = _REF.sub(_valid_ref, content)
        content = _RAW.sub(b'', content)
    """END OF GENERIC CODE FOR CLEANING."""
